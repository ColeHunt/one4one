{
  "name": "one4one",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev --workspace=server & npm run dev --workspace=web & wait",
    "build": "npm run build --workspace=web && npm run build --workspace=server",
    "start": "node server/dist/server/src/index.js",
    "test": "vitest run",
    "typecheck": "tsc -b shared server web"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
